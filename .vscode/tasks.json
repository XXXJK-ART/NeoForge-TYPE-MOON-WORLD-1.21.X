{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gradle: compileJava with warnings",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": [
                "compileJava",
                "--rerun-tasks",
                "--console=plain",
                "--init-script",
                ".codex_xlint.init.gradle"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "owner": "java",
                    "fileLocation": [
                        "absolute"
                    ],
                    "severity": "warning",
                    "pattern": {
                        "regexp": "^(.*\\.java):(\\d+):\\s*警告:\\s*(.*)$",
                        "file": 1,
                        "line": 2,
                        "message": 3
                    }
                },
                {
                    "owner": "java",
                    "fileLocation": [
                        "absolute"
                    ],
                    "severity": "error",
                    "pattern": {
                        "regexp": "^(.*\\.java):(\\d+):\\s*错误:\\s*(.*)$",
                        "file": 1,
                        "line": 2,
                        "message": 3
                    }
                },
                "$javac"
            ]
        }
    ]
}
