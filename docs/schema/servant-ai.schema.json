{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Type Moon World servant AI",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "maxLength": 128},
    "movement": {
      "type": "object",
      "properties": {
        "follow_distance": {"type": "number", "minimum": 0},
        "wander_radius": {"type": "number", "minimum": 0},
        "likes_high_places": {"type": "boolean"}
      }
    },
    "combat": {
      "type": "object",
      "properties": {
        "preferred_attack_distance": {"type": "number", "minimum": 0},
        "retreat_health_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "melee_preference": {"type": "number", "minimum": 0},
        "berserk_health_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "berserk_damage_multiplier": {"type": "number", "minimum": 0}
      }
    },
    "tactical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {"enum": ["balanced", "duelist", "vanguard", "berserker", "skirmisher", "sniper", "controller", "support", "ambusher", "disaster"]},
        "minimum_range": {"type": "number", "minimum": 0, "maximum": 48},
        "preferred_range": {"type": "number", "minimum": 0, "maximum": 48},
        "maximum_range": {"type": "number", "minimum": 0, "maximum": 48},
        "reposition_distance": {"type": "number", "minimum": 0, "maximum": 24},
        "pursuit_aggression": {"type": "number", "minimum": 0, "maximum": 1},
        "intercept_bias": {"type": "number", "minimum": 0, "maximum": 8},
        "vertical_mobility": {"type": "number", "minimum": 0, "maximum": 1},
        "recovery_tendency": {"type": "number", "minimum": 0, "maximum": 1},
        "collateral_caution": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_terrain_impact": {"enum": ["none", "chip", "small", "medium", "heavy", "np"]}
      }
    },
    "social": {"type": "object"},
    "command": {"type": "object"},
    "environment": {"type": "object"}
  }
}
